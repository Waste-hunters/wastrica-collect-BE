DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wastrica_collect?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
NODE_ENV="development"

# Africa's Talking SMS
# Use username "sandbox" only with sandbox credentials. For live SMS, use your live app username.
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="replace-with-africastalking-api-key"
AFRICASTALKING_SENDER_ID=""

# MTN MoMo / Airtel Money
# Set MOMO_ENVIRONMENT to "sandbox" for simulated payments (auto-confirms after 8s)
# Set to "production" when real MoMo API credentials are configured.
MOMO_ENVIRONMENT="sandbox"
MOMO_API_KEY=""
MOMO_API_USER=""
MOMO_CALLBACK_URL="http://localhost:3000/collect/v1/momo/webhook"
